# Generate independent random values: openssl rand -hex 32
APP_ORIGIN=http://localhost:3000
BOOTSTRAP_TOKEN=replace-with-a-random-one-time-setup-token
ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-key
