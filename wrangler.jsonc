{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunchju",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lunchju.juli.sh", "custom_domain": true }],
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunchju",
      "database_id": "f0018dc0-e21a-4f2f-86ae-cd8b2de2314c",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "lunchju-images" }],
  "durable_objects": {
    "bindings": [{ "name": "OAUTH_STATE", "class_name": "LunchJuOAuth" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LunchJuOAuth"] }],
  "vars": {
    "APP_ORIGIN": "https://lunchju.juli.sh",
    "HOME_NAME": "Stuttgart",
    "TIME_ZONE": "Europe/Berlin",
    "BRING_LIST_NAME": "Stuttgart",
    "BRING_LIST_ID": "cf1df8e3-984b-4782-a8b9-60eba7227f56",
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
}
